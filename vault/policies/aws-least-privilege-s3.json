{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBucketForBackups",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::lab-pam-backup-bucket"
    },
    {
      "Sid": "AllowReadOnlyAccessToBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::lab-pam-backup-bucket/*"
    },
    {
      "Sid": "DenyAllOtherS3Actions",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::*/*"
    }
  ]
}
