# ==============================================================================
# PAM Lab - Environment Configuration Template (.env.example)
# Copy to .env and configure local IP addresses and tokens for your lab session.
# DO NOT commit the populated .env file to version control.
# ==============================================================================

# Network & Host IPs (Example: 192.168.56.0/24 Host-Only Network)
DC01_IP=192.168.56.10
WIN_APP01_IP=192.168.56.11
LINUX01_IP=192.168.56.12
VAULT01_IP=192.168.56.20

# Active Directory Domain Settings
AD_DOMAIN=lab.local
AD_DOMAIN_CONTROLLER=DC01.lab.local

# HashiCorp Vault Configuration
VAULT_ADDR=http://192.168.56.20:8200
VAULT_TOKEN=s.exampleRootOrRotationTokenLabOnly

# ServiceNow Personal Developer Instance (PDI)
SNOW_INSTANCE=devXXXXX.service-now.com
SNOW_USER=pam_service_acct
SNOW_PASSWORD=ChangeMeLabPassword123!
SNOW_ASSIGNMENT_GROUP=Identity and Access Management

# AWS Lab Account (Optional - Phase 8)
